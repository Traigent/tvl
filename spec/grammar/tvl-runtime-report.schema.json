{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tvl-lang.org/schemas/tvl-runtime-report.schema.json",
  "title": "TVL Runtime Window Report",
  "description": "Schema for customer-side window reports tvl-runtime-report/1 (RFC 0003 §11.4.3).",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "format",
    "contract_digest",
    "monitor_ref",
    "monitor_revision",
    "window_start_ms",
    "counts",
    "tail_sampled",
    "coverage",
    "checker_refs",
    "salt_digest",
    "units_commitment",
    "sdk_version",
    "evidence_tier"
  ],
  "properties": {
    "format": { "const": "tvl-runtime-report/1" },
    "contract_digest": { "$ref": "#/$defs/Fingerprint" },
    "monitor_ref": { "$ref": "#/$defs/Ref" },
    "monitor_revision": { "$ref": "#/$defs/Ref" },
    "window_start_ms": { "type": "integer" },
    "counts": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "n",
        "k",
        "u_reported",
        "pl",
        "excluded",
        "selected",
        "reported",
        "dropped",
        "unattributed"
      ],
      "properties": {
        "n": { "$ref": "#/$defs/Nat" },
        "k": { "$ref": "#/$defs/Nat" },
        "u_reported": { "$ref": "#/$defs/Nat" },
        "pl": { "$ref": "#/$defs/Nat" },
        "excluded": { "$ref": "#/$defs/Nat" },
        "selected": { "$ref": "#/$defs/Nat" },
        "reported": { "$ref": "#/$defs/Nat" },
        "dropped": { "$ref": "#/$defs/Nat" },
        "unattributed": { "$ref": "#/$defs/Nat" }
      }
    },
    "tail_sampled": { "$ref": "#/$defs/Nat" },
    "coverage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "census",
        "unit_histories_complete",
        "producer_set_complete",
        "producer_sequences_contiguous",
        "response_deadlines_covered",
        "watermarks_through_ms"
      ],
      "properties": {
        "census": { "type": "boolean" },
        "unit_histories_complete": { "type": "boolean" },
        "producer_set_complete": { "type": "boolean" },
        "producer_sequences_contiguous": { "type": "boolean" },
        "response_deadlines_covered": { "type": "boolean" },
        "watermarks_through_ms": {
          "oneOf": [
            { "type": "null" },
            { "type": "integer" }
          ]
        }
      }
    },
    "checker_refs": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "oneOf": [
          { "const": "traigent.refusal.v1" },
          { "type": "string", "pattern": "^customer:[0-9a-f]{64}$" }
        ]
      }
    },
    "salt_digest": {
      "oneOf": [
        { "type": "null" },
        { "$ref": "#/$defs/Fingerprint" }
      ]
    },
    "units_commitment": { "$ref": "#/$defs/Fingerprint" },
    "sdk_version": {
      "type": "string",
      "maxLength": 32,
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "evidence_tier": { "const": "client_attested" }
  },
  "$defs": {
    "Nat": {
      "type": "integer",
      "minimum": 0
    },
    "Ref": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]{1,128}$"
    },
    "Fingerprint": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    }
  }
}
