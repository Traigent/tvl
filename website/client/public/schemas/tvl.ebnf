(* TVL — Abstract syntax oriented EBNF *)
(* Formal specification for Tuned Variables Language *)

module        = header, environment, evaluation_set, tvars, [ cvars ], [ constraints ], objectives, promotion_policy, [ policies ], [ composites ], [ requirements ], [ monitors ], [ responses ], [exploration] ;
tvl_pack      = "tvl_version", ":", ( "\"1.3\"" | "\"1.4\"" ), ",", "pack", ":", "{", "module", ":", ident, "}", ",",
                requirements, ",", pack_monitors, [ ",", responses ] ;                   (* D3 = A *)

header        = "tvl", ":", "{", "module", ":", ident, [",", "validation", ":", validation_opts], "}", [ "tvl_version", ":", string ] ;
validation_opts = "{", [ "skip_budget_checks", ":", boolean ], [ ",", "skip_cost_estimation", ":", boolean ], "}" ;

environment   = "environment", ":", "{",
                "snapshot_id", ":", string,              (* RFC3339 timestamp for E_τ *)
                [ ",", "bindings", ":", object ],        (* opaque deployment references: retriever index, gateway, catalog version *)
                [ ",", "context", ":", object ],         (* numeric environment facts used by operational preconditions *)
                "}" ;

evaluation_set = "evaluation_set", ":", "{", "dataset", ":", string, [ ",", "seed", ":", integer ], "}" ;

(* ==================== TYPE SYSTEM ==================== *)
(* TVL supports a closed set of types with product semantics for tuples *)

tvars         = "tvars", ":", "[", { tvar_decl { "," } }, "]" ;
tvar_decl     = "{", "name", ":", ident, ",", "type", ":", type, ",", "domain", ":", domain_spec, [ ",", scope_spec ], "}" ;

(* TVL 1.1 (RFC 0001) — ownership scope metadata; any field combination *)
scope_spec    = "scope", ":", "{", [ scope_field, { ",", scope_field } ], "}" ;
scope_field   = ( "node" | "agent" | "workflow" ), ":", ident ;

(* TVL 1.1 (RFC 0001 §3.3) — calibrated variables: governed, NOT searched.
   The optional domain is a VALIDITY domain (closed interval for floats; no
   resolution required), never a search domain. *)
cvars         = "cvars", ":", "[", [ cvar_decl, { ",", cvar_decl } ], "]" ;
cvar_decl     = "{", "name", ":", ident, ",", "type", ":", cvar_type,
                [ ",", "domain", ":", domain_spec ],
                ",", "calibration", ":", calibration_spec,
                [ ",", "governance", ":", governance_spec ],
                [ ",", scope_spec ], "}" ;
calibration_spec = "{", "source", ":", ident, [ ",", "signal", ":", ident ],
                [ ",", "calibrator", ":", ident ],
                [ ",", "depends_on", ":", "[", [ ident, { ",", ident } ], "]" ], "}" ;
governance_spec  = "{", "require_calibration", ":", boolean, "}" ;
cvar_type     = base_type | enum_type ;   (* tuple/callable CVARs deferred (RFC 0001 §3.3) *)

(* TVL 1.1 (RFC 0001 §3.8) — operational policies. stages are OPAQUE runtime
   stage identifiers (environment.bindings precedent), NOT namespace refs;
   gate thresholds ARE namespace refs and must resolve to a CVAR. *)
policies      = "policies", ":", "[", [ policy_decl, { ",", policy_decl } ], "]" ;
policy_decl   = "{", "name", ":", ident, ",", "kind", ":", "policy",
                ",", "strategy", ":", ident,
                ",", "stages", ":", "[", ident, { ",", ident }, "]",
                [ ",", "gates", ":", "[", [ gate_decl, { ",", gate_decl } ], "]" ],
                [ ",", "parameters", ":", object ],
                [ ",", scope_spec ], "}" ;
gate_decl     = "{", "kind", ":", "margin_below", ",", "threshold", ":", ident, "}" ;

(* TVL 1.2 (RFC 0002 §3.2/§3.9) — the sealed composite-knob algebra. A
   composite is a namespace/expansion/provenance unit, NOT a binding kind: it
   never enters Γ, the configuration space, or the dominance relation (§3.1).
   The grammar is the closed surface; the kind/gate/aggregate/stop REGISTRIES,
   arm resolution, acyclicity, threshold typing, and the signal/threshold
   calibration binding are enforced by the normative lints (the same
   shape-vs-registry layering RFC 0001 uses for policy strategy). A bare arm
   identifier is ALWAYS a stage (back-compatible with policies.stages); nesting
   REQUIRES the tagged { composite: ... } form. Modules with no composites block
   parse byte-identically to TVL 1.1 (§4). *)
composites    = "composites", ":", "[", [ composite_decl, { ",", composite_decl } ], "]" ;
composite_decl= "{", "name", ":", ident, ",", "kind", ":", composite_kind,
                ( cascade_body | ensemble_body | loop_body ),  (* discriminated by kind *)
                [ ",", "pattern", ":", ident ],         (* the ONLY surface provenance key (§3.7 sugar) *)
                [ ",", "parameters", ":", object ],      (* opaque operational map — OUTSIDE P8 *)
                [ ",", scope_spec ], "}" ;
composite_kind= "cascade" | "ensemble" | "loop" ;       (* SEALED registry *)

(* Cascade body — |arms| = m ≥ 1, |gates| = m − 1, placement default post *)
cascade_body  = [ ",", "placement", ":", ( "pre" | "post" ) ],
                ",", "arms", ":", "[", arm_surface, { ",", arm_surface }, "]",
                [ ",", "gates", ":", "[", [ composite_gate, { ",", composite_gate } ], "]" ] ;

(* Ensemble body — cardinality REQUIRED iff |arms| = 1, FORBIDDEN if |arms| > 1 *)
ensemble_body = ",", "arms", ":", "[", arm_surface, { ",", arm_surface }, "]",
                [ ",", "cardinality", ":", ident ],     (* TVAR/CVAR of TVL type int; k ≥ 1 (R9) *)
                ",", "aggregate", ":", aggregate_decl ;

(* Loop body — max_iters REQUIRED bound (totality) *)
loop_body     = ",", "body", ":", arm_surface,
                [ ",", "state_keys", ":", "[", [ ident, { ",", ident } ], "]" ],
                ",", "stop", ":", stop_decl,
                ",", "max_iters", ":", integer ;

(* The ONE arm surface form (§3.9): bare = stage(tuned_params []); tagged forms
   are stage with explicit tuned_params, or { composite: ident } nesting. *)
arm_surface   = ident
              | "{", "stage", ":", ident, [ ",", "tuned_params", ":", "[", [ ident, { ",", ident } ], "]" ], "}"
              | "{", "composite", ":", ident, "}" ;

(* The signal surface form (§3.9): everywhere a SignalUse appears *)
signal_surface= "{", "signal", ":", ident, [ ",", "inputs", ":", "[", [ ident, { ",", ident } ], "]" ], "}" ;

(* Composite cascade gate — margin_below (POST-only) | signal_below (PRE-only) *)
composite_gate= "{", "kind", ":", gate_kind, ",", "threshold", ":", ident,
                [ ",", "signal", ":", signal_surface ], "}" ;  (* signal REQUIRED iff signal_below *)
gate_kind     = "margin_below" | "signal_below" ;       (* v1 registry *)

(* Ensemble aggregate — majority_vote | judge_max; judge REQUIRED iff judge_max *)
aggregate_decl= "{", "kind", ":", aggregate_kind,
                [ ",", "judge", ":", arm_surface ],
                [ ",", "accept", ":", accept_decl ], "}" ;
aggregate_kind= "majority_vote" | "judge_max" ;         (* v1 registry *)

(* Optional ensemble acceptance — direction ≥, DISTINCT from cascade < *)
accept_decl   = "{", "kind", ":", "stat_at_least",
                ",", "stat", ":", ( "vote_margin" | "vote_agreement" ),
                ",", "threshold", ":", ident, "}" ;

(* Loop stop — signal_accept (unroll-eligible) | external_accept | exhausted *)
stop_decl     = "{", "kind", ":", stop_kind,
                [ ",", "threshold", ":", ident ],       (* REQUIRED iff signal_accept *)
                [ ",", "signal", ":", signal_surface ], (* REQUIRED iff signal_accept; inputs ⊆ state_keys *)
                [ ",", "predicate", ":", ident ], "}" ; (* REQUIRED iff external_accept; opaque, outside P8 *)
stop_kind     = "signal_accept" | "external_accept" | "exhausted" ;  (* v1 registry *)

(* TVL 1.3 (RFC 0003 §4.1) — runtime requirements, monitors, and responses.
   The catalogue is sealed; shape-versus-registry layering matches RFC 0001/0002. *)
requirements  = "requirements", ":", "[", [ req_decl, { ",", req_decl } ], "]" ;
req_decl      = rate_req | zero_req | recovery_req | liveness_req ;                      (* SEALED *)
rate_req      = "{", "name", ":", runtime_ident, ",", "kind", ":", "rate_bound", ",", "unit", ":", unit_kind,
                [ ",", "among", ":", checker_pred ], ",", "violation", ":", pred, ",", "max_rate", ":", number, "}" ;
zero_req      = "{", "name", ":", runtime_ident, ",", "kind", ":", "zero_tolerance", ",", "unit", ":", unit_kind,
                [ ",", "among", ":", checker_pred ], ",", "violation", ":", exact_pred, "}" ;
recovery_req  = "{", "name", ":", runtime_ident, ",", "kind", ":", "recovery_time", ",", "unit", ":", "episode",
                ",", "of", ":", runtime_ident, ",", "within_hours", ":", integer, "}" ;
liveness_req  = "{", "name", ":", runtime_ident, ",", "kind", ":", "evidence_liveness", ",", "unit", ":", "window",
                ",", "of", ":", runtime_ident, ",", "max_stale_windows", ":", integer, "}" ;
unit_kind     = "trace" | "invocation" ;
pred          = metric_pred | exact_pred | checker_pred ;
exact_pred    = "{", "pattern", ":", "absence", ",", "a", ":", sel, "}"
              | "{", "pattern", ":", "bounded_existence", ",", "a", ":", sel, ",", "max_count", ":", integer, "}"
              | "{", "pattern", ":", "precedence", ",", "a", ":", sel, ",", "b", ":", sel,
                [ ",", "mode", ":", ( "single_use" | "reusable" ) ],
                [ ",", "correlate_by", ":", corr ], "}"
              | "{", "pattern", ":", "bounded_response", ",", "a", ":", sel, ",", "b", ":", sel,
                ",", "within_ms", ":", integer, [ ",", "correlate_by", ":", corr ], "}"
              | "{", "pattern", ":", "protocol", ",", "alphabet", ":", "[", sel, { ",", sel }, "]",
                ",", "states", ":", "[", runtime_ident, { ",", runtime_ident }, "]",
                ",", "start", ":", runtime_ident,
                ",", "transitions", ":", "[", [ transition, { ",", transition } ], "]",
                ",", "accepting", ":", "[", [ runtime_ident, { ",", runtime_ident } ], "]",
                ",", "rejecting", ":", "[", [ runtime_ident, { ",", runtime_ident } ], "]",
                [ ",", "unlisted", ":", ( "reject" | "ignore" ) ], "}" ;
transition    = "{", "from", ":", runtime_ident, ",", "when", ":", sel, ",", "to", ":", runtime_ident, "}" ; (* C8 *)
corr          = "unit" | "correlation_id" | "tool_call_id" ;
metric_pred   = "{", "metric", ":", ( "wall_clock_latency_ms" | "cost_usd" | "total_tokens" | "tool_calls" ),
                ",", "exceeds", ":", number, "}" ;
checker_pred  = "{", "checker", ":", checker_id, ",", "label_in", ":", "[", runtime_ident, { ",", runtime_ident }, "]", "}" ;
checker_id    = "traigent.refusal.v1" | customer_checker_id ;
sel           = "{", "event", ":", event_type, [ ",", "tool", ":", ident ],
                [ ",", "status", ":", status ], [ ",", "ref", ":", runtime_ident ], "}" ;
event_type    = "unit_start" | "unit_end" | "tool_call" | "tool_result" | "model_call" | "handoff" | "error"
              | "authorization_granted" | "authorization_revoked" ;
status        = "running" | "completed" | "failed" | "rejected" ;

monitors      = "monitors", ":", "[", [ mon_decl, { ",", mon_decl } ], "]" ;
pack_monitors = "monitors", ":", "[", [ pack_mon_decl, { ",", pack_mon_decl } ], "]" ;
mon_decl      = "{", mon_fields, [ ",", "applies_to", ":", "agent" ], "}" ;
pack_mon_decl = "{", mon_fields, ",", "applies_to", ":", "tenant_floor", "}" ;
mon_fields    = "name", ":", runtime_ident, ",", "requirement", ":", runtime_ident,
                ",", "phase", ":", ( "promotion" | "runtime" ), [ ",", "profile", ":", "backend_v1" ],
                ",", "evidence", ":", evidence_spec, [ ",", "window", ":", window_spec ],
                ",", "decision", ":", decision_spec, [ ",", "episode", ":", episode_spec ],
                [ ",", "limits", ":", limits_spec ], [ ",", "single_producer", ":", boolean ] ;
evidence_spec = "{", "source", ":", ( "backend_trace_metadata" | "customer_side" | "evaluation_set" | "episodes" | "windows" ),
                [ ",", "deployment_environment", ":", string ],
                [ ",", "attribution", ":", "agent_key_exact_v1" ],
                [ ",", "resolution", ":", "terminal_status_v1" ],
                [ ",", "sampling", ":", sampling_spec ], "}" ;
sampling_spec = "unverified"
              | "{", "mode", ":", ( "head_sampled_declared" | "hash_bernoulli_committed_v1" ), ",", "rate", ":", number, "}" ;
window_spec   = "{", "tumbling_hours", ":", integer, ",", "grace_minutes", ":", integer, "}" ;
decision_spec = "{", "method", ":", ( "clopper_pearson_exact_v1" | "clopper_pearson_rational_v2" | "exact_count_v1" ),
                [ ",", "model", ":", "iid_bernoulli_within_window_v1" ],
                [ ",", "confidence", ":", number ],
                [ ",", "false_alarm_budget", ":", number ],
                [ ",", "horizon_days", ":", integer ],
                [ ",", "min_samples", ":", integer ],
                [ ",", "max_unresolved_fraction", ":", number ],
                [ ",", "threshold_factor", ":", number ], "}" ;
episode_spec  = "{", "closure_windows", ":", integer, ",", "closure_max_age_hours", ":", integer, "}" ;
limits_spec   = "{", [ "max_active_obligations", ":", integer ], [ ",", "max_tracked_correlations", ":", integer ], "}" ;

responses     = "responses", ":", "[", [ resp_decl, { ",", resp_decl } ], "]" ;
resp_decl     = "{", "name", ":", runtime_ident, ",", "rules", ":", "[", [ rule_decl, { ",", rule_decl } ], "]", "}" ;
rule_decl     = "{", "id", ":", runtime_ident, ",", "trigger", ":", trigger_spec, ",", "do", ":", action_kind,
                [ ",", "approval", ":", ( "none" | "standing" | "human" ) ],
                [ ",", "target", ":", ( "last_certified" | fingerprint ) ],
                [ ",", "severity", ":", severity ],
                [ ",", "fallback", ":", ( "static_unavailable" | "route_to_human" | fingerprint ) ],
                [ ",", "rate_floor", ":", number ],
                [ ",", "repeat_after_hours", ":", integer ],
                [ ",", "max_repeats", ":", integer ],
                [ ",", "on_check_error", ":", ( "block" | "allow" ) ],
                [ ",", "deploy", ":", ( "never" | "if_promoted" ) ],
                [ ",", "only_while", ":", "[", [ guard, { ",", guard } ], "]" ],
                [ ",", "unless", ":", "[", [ guard, { ",", guard } ], "]" ], "}" ;            (* C1; deploy: optimize only *)
trigger_spec  = monitor_trigger | outcome_trigger ;
outcome_trigger = "{", "rule", ":", runtime_ident, ",", "event", ":", outcome_event, "}" ;
outcome_event = "optimize_no_candidate" | "optimize_failed" | "deploy_refused" | "deploy_failed" ;
guard         = "{", "monitor", ":", runtime_ident, ",", "state", ":", "episode_open", "}"
              | "{", "rule", ":", runtime_ident, ",", "state", ":", "attempt_open", "}" ;
monitor_trigger = "{", "monitor", ":", runtime_ident, ",", "event", ":", event_name, [ ",", "hours", ":", integer ], "}" ;
event_name    = "episode_opened" | "episode_continued" | "episode_open_for" | "episode_resolved" | "episode_withdrawn"
              | "recovery_overdue" | "recovery_cancelled" | "recovery_recovered" | "burn_breached"
              | "stale" | "live_again" | "unit_violation" | "unknown_for" ;
action_kind   = "notify" | "open_next_step" | "optimize" | "rollback" | "throttle" | "degrade" | "suspend"
              | "block_action" | "halt_unit" ;                                           (* SEALED *)
severity      = "info" | "warning" | "critical" ;
runtime_ident = ? plain identifier (no dots): [A-Za-z_][A-Za-z0-9_]* ? ;
customer_checker_id = ? customer checker identifier: customer:[A-Za-z_][A-Za-z0-9_]* ? ;
fingerprint   = ? 64 lowercase hexadecimal characters: [0-9a-f]{64} ? ;

(* Type grammar - complete specification *)
type          = base_type | compound_type ;
base_type     = "bool" | "int" | "float" ;
compound_type = enum_type | tuple_type | callable_type ;

(* Enum types: finite discrete sets over a base element type *)
enum_type     = "enum[", enum_element, "]" ;
enum_element  = "str" | "int" | "float" ;

(* Tuple types: product type (A × B × ...) - NOT a tagged union *)
(* Semantics: Configuration space grows as Cartesian product of component domains *)
tuple_type    = "tuple[", type_list, "]" ;
type_list     = type, { ",", type } ;

(* Callable types: reference to protocol-defined functions *)
(* Resolution: Lazy at specialization time via registry lookup *)
callable_type = "callable[", ProtoId, "]" ;
ProtoId       = ident ;                                  (* Protocol identifier in registry *)

(* ==================== DOMAIN SPECIFICATIONS ==================== *)
(* Domains are specialized by environment snapshots (E_τ) *)

domain_spec   = enum_vals | range_spec | set_vals | registry_ref | tuple_components ;

(* Finite enumeration of literal values *)
enum_vals     = "[", value, { ",", value }, "]" ;

(* Numeric range with optional discretization *)
range_spec    = "{", "range", ":", "[", number, ",", number, "]",
                [ ",", "resolution", ":", number ],      (* Default: 1 for int, 0.001 for float *)
                "}" ;

(* Explicit set (wrapper form for metadata attachment) *)
set_vals      = "{", "set", ":", "[", value, { ",", value }, "]", "}" ;

(* Tuple product domain: each component is itself a domain spec *)
tuple_components = "{", "components", ":", "[", tuple_component, { ",", tuple_component }, "]", "}" ;
tuple_component  = enum_vals | range_spec | set_vals | registry_ref | tuple_components ;
(* Implementation note: for tuple components, float ranges require explicit resolution
   to guarantee finite deterministic enumeration in the reference checker. *)

(* Registry reference for dynamic domain resolution *)
(* Resolved lazily: registry_ref → resolve(E_τ, R) → set[values] *)
registry_ref  = "{", "registry", ":", ident,
                [ ",", "filter", ":", filter_expr ],     (* Optional predicate for filtering *)
                [ ",", "version", ":", string ],         (* Optional version constraint *)
                "}" ;
filter_expr   = string ;                                 (* Implementation-defined predicate *)

constraints   = "constraints", ":", "{", [ structural ], [ ",", derived ], "}" ;
structural    = "structural", ":", "[", { struct_clause { "," } }, "]" ;
struct_clause = "{", ( ("when", ":", formula, ",", "then", ":", formula) | ("expr", ":", formula) ), "}" ;
derived       = "derived", ":", "[", { "{", "require", ":", lin_arith_expr, "}" { "," } }, "]" ;

objectives    = "objectives", ":", "[", { objective_decl { "," } }, "]" ;
objective_decl= std_objective | band_objective ;
std_objective = "{", "name", ":", ident, [ ",", "metric_ref", ":", string ], ",", "direction", ":", ("maximize" | "minimize"), "}" ;
band_objective= "{", "name", ":", ident, [ ",", "metric_ref", ":", string ], ",", "band", ":", "{",
                 "target", ":", ( "[" , number, ",", number, "]" | "{", "center", ":", number, ",", "tol", ":", number, "}" ),
                 [ ",", "test", ":", "TOST" ], [ ",", "alpha", ":", number ], "}", "}" ;

promotion_policy = "promotion_policy", ":", "{",
                   "dominance", ":", "epsilon_pareto",
                   [ ",", "alpha", ":", number ],            (* defaults to 0.05 when omitted *)
                   [ ",", "min_effect", ":", "{", ident, ":", number, { ",", ident, ":", number }, "}" ],
                   [ ",", "adjust", ":", ("none" | "bonferroni" | "holm" | "BH") ],
                   [ ",", "chance_constraints", ":", "[", { "{", "name", ":", ident, ",", "threshold", ":", number, ",", "confidence", ":", number, "}" { "," } }, "]" ],
                   [ ",", "tie_breakers", ":", "{", ident, ":", ("min" | "max" | "min_abs_deviation" | "custom"), { ",", ident, ":", ("min" | "max" | "min_abs_deviation" | "custom") }, "}" ],
                   [ ",", require_calibration_spec ],
                   "}" ;

(* TVL 1.1 (RFC 0001 §3.5) — strict evidence mode. The mandatory ctx_core is
   implicit and immutable; hash_covered_context selects EXTENSION keys only. *)
require_calibration_spec = "require_calibration", ":", "{",
                   "enabled", ":", boolean,
                   [ ",", "hash_covered_context", ":", "[", [ ctx_ext_key, { ",", ctx_ext_key } ], "]" ],
                   [ ",", "signal_inputs", ":", "[", [ ident, { ",", ident } ], "]" ],  (* TVL 1.2: the ordered value covered under the signal_inputs key (§3.2 item 11) *)
                   "}" ;
ctx_ext_key   = "stage_versions" | "model_versions" | "budget_assumptions" | "cost_assumptions"
              | "signal_inputs" ;   (* TVL 1.2 (RFC 0002 §3.2 item 11): use-site SignalUse.inputs freshness *)

exploration   = "exploration", ":", "{",
                "strategy", ":", "{", "type", ":", ("random" | "grid" | "tpe" | "cmaes" | "nsga2" | "custom"), { "," key, ":", value }, "}",
                [ ",", "initial_sampling", ":", value ],
                [ ",", "parallelism", ":", "{", "max_parallel_trials", ":", integer, { "," key, ":", value }, "}" ],
                [ ",", "convergence", ":", "{", "metric", ":", ("hypervolume_improvement" | "none"), [ ",", "window", ":", integer ], [ ",", "threshold", ":", number ], "}" ],
                [ ",", "budgets", ":", "{", [ "max_trials", ":", integer ], [ ",", "max_spend_usd", ":", number ], [ ",", "max_wallclock_s", ":", integer ], "}" ],
                "}" ;

(* ==================== CONSTRAINT LANGUAGE ==================== *)
(* Typed Disjunctive Normal Form (DNF) - NOT CEL *)
(* Compiles to SAT/SMT (QF_LIA/QF_LRA) for decidability *)

(* Structural constraints: Boolean formulas over TVARs *)
(* Evaluated at structural feasibility check (F^str) *)
formula       = implication ;
implication   = disjunction , [ "=>" , formula ] ;        (* Sugar: A => B ≡ ¬A ∨ B *)
disjunction   = conjunction , { "or" , conjunction } ;
conjunction   = unary , { "and" , unary } ;
unary         = [ "not" ] , ( atom | "(" , formula , ")" ) ;

(* Atoms: type-checked predicates over TVARs *)
atom          = equality_atom | comparison_atom | interval_atom | tvar_eq_atom | membership_atom ;

(* Equality: t (=|!=) a where typeof(t) = typeof(a) *)
equality_atom = ident , ("=" | "!=") , value ;

(* Comparison: t (>=|<=|>|<) n where t is numeric (int/float) and n is numeric literal *)
comparison_atom = ident , (">=" | "<=" | ">" | "<") , number ;

(* Interval: a <= t <= b where t is numeric and a <= b *)
interval_atom = number , ("<=" | "<") , ident , ("<=" | "<") , number ;

(* TVAR equality: t1 (=|!=) t2 where typeof(t1) = typeof(t2) *)
tvar_eq_atom  = ident , ("=" | "!=") , ident ;

(* Set membership: t in S where S ⊆ domain(t) *)
membership_atom = ident , "in" , set_literal ;

set_literal   = "{" , value , { "," , value } , "}" ;
(* Comparisons only accept numeric literals; TVAR-to-TVAR checks are limited to equality/inequality. *)

(* ==================== DERIVED CONSTRAINTS ==================== *)
(* Linear arithmetic over numeric env.context symbols (not TVARs) *)
(* Evaluated at operational feasibility check (F^op) *)
lin_arith_expr= affine_term , { ("+" | "-") , affine_term } , comparison_op , number ;
affine_term   = [ coefficient , "*" ] , env_ident | coefficient ;
comparison_op = "<=" | ">=" | "=" | "<" | ">" ;
coefficient   = number ;
env_ident     = ident ;                                  (* Must resolve to numeric env.context symbols, not TVARs *)

(* ==================== TERMINALS ==================== *)
ident         = ? identifier: [A-Za-z_][A-Za-z0-9_]*(\.[A-Za-z_][A-Za-z0-9_]*)* ? ;
                                                         (* The single normative Ident grammar (RFC 0001 §3.7(2)):
                                                            dot-separated segments, each starting with a letter or
                                                            underscore — no leading/trailing/double dots. Matches
                                                            tvl.schema.json's pattern exactly. *)
number        = ? number literal: -?[0-9]+(\.[0-9]+)?(e[+-]?[0-9]+)? ? ;
integer       = ? integer literal: -?[0-9]+ ? ;
string        = ? quoted string literal with backslash escapes ("..." or '...') ? ;
value         = number | string | boolean | tuple_val ;
tuple_val     = "(" , value , { "," , value } , ")" ;
boolean       = "true" | "false" ;
key           = ident ;
object        = "{" , { key , ":" , value , { "," } } , "}" ;
