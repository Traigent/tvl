{
  "TVL 1.3 Rate-Bound Requirement, Monitor, and Liveness Pair": {
    "prefix": "tvl-rate-bound",
    "description": "TVL 1.3 rate_bound requirement with runtime monitor and evidence_liveness pair",
    "body": [
      "requirements:",
      "  - name: ${1:latency_2s}",
      "    kind: rate_bound",
      "    unit: ${2|trace,invocation|}",
      "    violation: { metric: ${3|wall_clock_latency_ms,cost_usd,total_tokens,tool_calls|}, exceeds: ${4:2000} }",
      "    max_rate: ${5:0.05}",
      "  - name: ${1:latency_2s}_live",
      "    kind: evidence_liveness",
      "    unit: window",
      "    of: ${1:latency_2s}_prod",
      "    max_stale_windows: ${6:4}",
      "",
      "monitors:",
      "  - name: ${1:latency_2s}_prod",
      "    requirement: ${1:latency_2s}",
      "    phase: runtime",
      "    evidence: { source: ${7|customer_side,backend_trace_metadata|}, deployment_environment: ${8:production} }",
      "    window: { tumbling_hours: ${9|6,1,2,3,4,8,12,24|}, grace_minutes: ${10:30} }",
      "    decision:",
      "      method: ${11|clopper_pearson_rational_v2,clopper_pearson_exact_v1|}",
      "      confidence: ${12:0.95}",
      "      false_alarm_budget: ${13:0.05}",
      "      horizon_days: ${14:30}",
      "      min_samples: ${15:200}",
      "      max_unresolved_fraction: ${16:0.05}",
      "    episode: { closure_windows: ${17:2}, closure_max_age_hours: ${18:24} }",
      "  - name: ${1:latency_2s}_live_check",
      "    requirement: ${1:latency_2s}_live",
      "    phase: runtime",
      "    evidence: { source: windows }",
      "    decision: { method: exact_count_v1 }"
    ]
  },
  "TVL 1.3 Zero-Tolerance Requirement and Guard": {
    "prefix": "tvl-zero-tolerance-guard",
    "description": "TVL 1.3 zero_tolerance requirement with customer_side monitor, liveness pair, and local guard response",
    "body": [
      "requirements:",
      "  - name: ${1:no_write_sql}",
      "    kind: zero_tolerance",
      "    unit: ${2|invocation,trace|}",
      "    violation: { pattern: ${3|absence,bounded_existence,precedence,bounded_response,protocol|}, a: { event: ${4|tool_call,tool_result,model_call,handoff,error,unit_start,unit_end,authorization_granted,authorization_revoked|}, tool: ${5:warehouse.run_write_sql} } }",
      "  - name: ${1:no_write_sql}_live",
      "    kind: evidence_liveness",
      "    unit: window",
      "    of: ${1:no_write_sql}_prod",
      "    max_stale_windows: ${6:2}",
      "",
      "monitors:",
      "  - name: ${1:no_write_sql}_prod",
      "    requirement: ${1:no_write_sql}",
      "    phase: runtime",
      "    evidence: { source: customer_side, deployment_environment: ${7:production} }",
      "    window: { tumbling_hours: ${8|24,12,8,6,4,3,2,1|}, grace_minutes: ${9:60} }",
      "    decision: { method: exact_count_v1 }",
      "    episode: { closure_windows: ${10:1}, closure_max_age_hours: ${11:48} }",
      "  - name: ${1:no_write_sql}_live_check",
      "    requirement: ${1:no_write_sql}_live",
      "    phase: runtime",
      "    evidence: { source: windows }",
      "    decision: { method: exact_count_v1 }",
      "",
      "responses:",
      "  - name: ${1:no_write_sql}_guard",
      "    rules:",
      "      - { id: ${12:block_violation}, trigger: { monitor: ${1:no_write_sql}_prod, event: unit_violation }, do: ${13|block_action,halt_unit|}, on_check_error: ${14|block,allow|} }",
      "      - { id: ${15:page_open}, trigger: { monitor: ${1:no_write_sql}_prod, event: episode_opened }, do: notify, severity: ${16|critical,warning,info|} }"
    ]
  },
  "TVL 1.3 Recovery Time Obligation": {
    "prefix": "tvl-recovery",
    "description": "TVL 1.3 recovery_time requirement and episodes obligation monitor",
    "body": [
      "# Add under requirements:",
      "  - name: ${1:latency_recovers_24h}",
      "    kind: recovery_time",
      "    unit: episode",
      "    of: ${2:latency_2s_prod}",
      "    within_hours: ${3:24}",
      "",
      "# Add under monitors:",
      "  - name: ${1:latency_recovers_24h}_check",
      "    requirement: ${1:latency_recovers_24h}",
      "    phase: runtime",
      "    evidence: { source: episodes }",
      "    decision: { method: exact_count_v1 }"
    ]
  },
  "TVL 1.3 Promotion Monitor": {
    "prefix": "tvl-promotion-monitor",
    "description": "TVL 1.3 promotion monitor for release gating on evaluation_set",
    "body": [
      "  - name: ${1:latency_2s}_gate",
      "    requirement: ${1:latency_2s}",
      "    phase: promotion",
      "    evidence: { source: evaluation_set }",
      "    decision:",
      "      method: ${2|clopper_pearson_rational_v2,exact_count_v1|}",
      "      confidence: ${3:0.95}",
      "      false_alarm_budget: ${4:0.05}"
    ]
  },
  "TVL 1.3 Responses Escalation Ladder": {
    "prefix": "tvl-responses-ladder",
    "description": "TVL 1.3 responses ladder with notify, open_next_step, rollback, and human-approved suspend",
    "body": [
      "responses:",
      "  - name: ${1:latency_ladder}",
      "    rules:",
      "      - { id: ${2:warn_open}, trigger: { monitor: ${3:latency_2s_prod}, event: episode_opened }, do: notify, severity: ${4|warning,critical,info|} }",
      "      - { id: ${5:next_step}, trigger: { monitor: ${3:latency_2s_prod}, event: episode_opened }, do: open_next_step }",
      "      - { id: ${6:rollback_6h}, trigger: { monitor: ${3:latency_2s_prod}, event: episode_open_for, hours: ${7:6} }, do: rollback, target: ${8:last_certified}, approval: ${9|standing,human|} }",
      "      - { id: ${10:suspend_overdue}, trigger: { monitor: ${11:latency_recovers_24h_check}, event: recovery_overdue }, do: suspend, approval: human, fallback: ${12|route_to_human,static_unavailable|} }",
      "      - { id: ${13:info_resolved}, trigger: { monitor: ${3:latency_2s_prod}, event: episode_resolved }, do: notify, severity: info }"
    ]
  },
  "TVL 1.3 Pack Organisation Floor": {
    "prefix": "tvl-pack-floor",
    "description": "TVL 1.3 tvl_pack document with tenant_floor monitors and responses",
    "body": [
      "tvl_version: \"1.3\"",
      "pack:",
      "  module: ${1:org.floors}",
      "requirements:",
      "  - name: ${2:floor_latency_2s}",
      "    kind: rate_bound",
      "    unit: trace",
      "    violation: { metric: wall_clock_latency_ms, exceeds: ${3:2000} }",
      "    max_rate: ${4:0.10}",
      "  - name: ${2:floor_latency_2s}_live",
      "    kind: evidence_liveness",
      "    unit: window",
      "    of: ${2:floor_latency_2s}_prod",
      "    max_stale_windows: ${5:4}",
      "monitors:",
      "  - name: ${2:floor_latency_2s}_prod",
      "    requirement: ${2:floor_latency_2s}",
      "    phase: runtime",
      "    profile: backend_v1",
      "    applies_to: tenant_floor",
      "    evidence: { source: backend_trace_metadata, deployment_environment: ${6:production} }",
      "    window: { tumbling_hours: ${7:6}, grace_minutes: ${8:30} }",
      "    decision:",
      "      method: clopper_pearson_exact_v1",
      "      confidence: ${9:0.95}",
      "      false_alarm_budget: ${10:0.05}",
      "      horizon_days: ${11:30}",
      "      min_samples: ${12:200}",
      "      max_unresolved_fraction: ${13:0.05}",
      "    episode: { closure_windows: ${14:2}, closure_max_age_hours: ${15:24} }",
      "  - name: ${2:floor_latency_2s}_live_check",
      "    requirement: ${2:floor_latency_2s}_live",
      "    phase: runtime",
      "    applies_to: tenant_floor",
      "    evidence: { source: windows }",
      "    decision: { method: exact_count_v1 }",
      "responses:",
      "  - name: ${16:floor_alerts}",
      "    rules:",
      "      - { id: ${17:floor_open}, trigger: { monitor: ${2:floor_latency_2s}_prod, event: episode_opened }, do: notify, severity: warning }",
      "      - { id: ${18:floor_stale}, trigger: { monitor: ${2:floor_latency_2s}_live_check, event: stale }, do: notify, severity: critical }"
    ]
  }
}
