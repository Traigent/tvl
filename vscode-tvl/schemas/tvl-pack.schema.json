{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tvl-lang.org/schemas/tvl-pack.schema.json",
  "title": "TVL Pack",
  "description": "Schema for TVL 1.3 organisation floor packs (RFC 0003 §4.1, §5.1, §11.4.8).",
  "type": "object",
  "additionalProperties": false,
  "required": ["pack", "requirements", "monitors"],
  "properties": {
    "tvl_version": {
      "type": ["string", "number"],
      "description": "Declared language version; runtime lints require 1.5 for breach persistence and census aggregates, 1.4 for reactive outcomes and guards, otherwise 1.3, 1.4 or 1.5."
    },
    "pack": {
      "type": "object",
      "additionalProperties": false,
      "required": ["module"],
      "properties": {
        "module": {
          "type": "string",
          "pattern": "^[A-Za-z_][A-Za-z0-9_]*(\\.[A-Za-z_][A-Za-z0-9_]*)*$"
        }
      }
    },
    "requirements": {
      "type": "array",
      "items": { "$ref": "#/$defs/RequirementDecl" }
    },
    "monitors": {
      "type": "array",
      "items": { "$ref": "#/$defs/MonitorDecl" }
    },
    "responses": {
      "type": "array",
      "items": { "$ref": "#/$defs/ResponseDecl" }
    }
  },
  "$defs": {
    "RuntimeIdent": {
      "type": "string",
      "pattern": "^[A-Za-z_][A-Za-z0-9_]*$",
      "description": "TVL 1.3 runtime identifier (plain ident, no dots; RFC 0003 §4.2)."
    },
    "RequirementDecl": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "kind", "unit"],
      "properties": {
        "name": { "$ref": "#/$defs/RuntimeIdent" },
        "kind": { "type": "string" },
        "unit": { "type": "string" },
        "among": { "$ref": "#/$defs/PredicateDecl" },
        "violation": { "$ref": "#/$defs/PredicateDecl" },
        "max_rate": { "type": "number" },
        "of": { "$ref": "#/$defs/RuntimeIdent" },
        "within_hours": { "type": "integer" },
        "max_stale_windows": { "type": "integer" },
        "aggregate": { "$ref": "#/$defs/RuntimeAggregateDecl" },
        "bound": { "$ref": "#/$defs/BoundDecl" }
      }
    },
    "PredicateDecl": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "metric": { "type": "string" },
        "exceeds": { "type": "number" },
        "checker": { "type": "string" },
        "label_in": {
          "type": "array",
          "items": { "type": "string" }
        },
        "pattern": { "type": "string" },
        "a": { "$ref": "#/$defs/SelectorDecl" },
        "b": { "$ref": "#/$defs/SelectorDecl" },
        "max_count": { "type": "integer" },
        "mode": { "type": "string" },
        "correlate_by": { "type": "string" },
        "within_ms": { "type": "integer" },
        "alphabet": {
          "type": "array",
          "items": { "$ref": "#/$defs/SelectorDecl" }
        },
        "states": {
          "type": "array",
          "items": { "$ref": "#/$defs/RuntimeIdent" }
        },
        "start": { "$ref": "#/$defs/RuntimeIdent" },
        "transitions": {
          "type": "array",
          "items": { "$ref": "#/$defs/TransitionDecl" }
        },
        "accepting": {
          "type": "array",
          "items": { "$ref": "#/$defs/RuntimeIdent" }
        },
        "rejecting": {
          "type": "array",
          "items": { "$ref": "#/$defs/RuntimeIdent" }
        },
        "unlisted": { "type": "string" }
      }
    },
    "SelectorDecl": {
      "type": "object",
      "additionalProperties": false,
      "required": ["event"],
      "properties": {
        "event": { "type": "string" },
        "tool": { "type": "string" },
        "status": { "type": "string" },
        "ref": { "$ref": "#/$defs/RuntimeIdent" }
      }
    },
    "TransitionDecl": {
      "type": "object",
      "additionalProperties": false,
      "required": ["from", "when", "to"],
      "properties": {
        "from": { "$ref": "#/$defs/RuntimeIdent" },
        "when": { "$ref": "#/$defs/SelectorDecl" },
        "to": { "$ref": "#/$defs/RuntimeIdent" }
      }
    },
    "MonitorDecl": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "requirement", "phase", "evidence", "decision"],
      "properties": {
        "name": { "$ref": "#/$defs/RuntimeIdent" },
        "requirement": { "$ref": "#/$defs/RuntimeIdent" },
        "phase": { "type": "string" },
        "profile": { "type": "string" },
        "applies_to": { "type": "string" },
        "evidence": { "$ref": "#/$defs/EvidenceDecl" },
        "window": { "$ref": "#/$defs/WindowDecl" },
        "decision": { "$ref": "#/$defs/DecisionDecl" },
        "episode": { "$ref": "#/$defs/EpisodeDecl" },
        "limits": { "$ref": "#/$defs/LimitsDecl" },
        "single_producer": { "type": "boolean" }
      }
    },
    "EvidenceDecl": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source"],
      "properties": {
        "source": { "type": "string" },
        "deployment_environment": { "type": "string" },
        "attribution": { "type": "string" },
        "resolution": { "type": "string" },
        "sampling": { "$ref": "#/$defs/SamplingDecl" }
      }
    },
    "SamplingDecl": {
      "oneOf": [
        { "type": "string" },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["mode", "rate"],
          "properties": {
            "mode": { "type": "string" },
            "rate": { "type": "number" }
          }
        }
      ]
    },
    "WindowDecl": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "tumbling_hours": { "type": "integer" },
        "grace_minutes": { "type": "integer" }
      }
    },
    "DecisionDecl": {
      "type": "object",
      "additionalProperties": false,
      "required": ["method"],
      "properties": {
        "method": { "type": "string" },
        "model": { "type": "string" },
        "confidence": { "type": "number" },
        "false_alarm_budget": { "type": "number" },
        "horizon_days": { "type": "integer" },
        "min_samples": { "type": "integer" },
        "max_unresolved_fraction": { "type": "number" },
        "threshold_factor": { "type": "number" }
      }
    },
    "EpisodeDecl": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "closure_windows": { "type": "integer" },
        "closure_max_age_hours": { "type": "integer" }
      }
    },
    "LimitsDecl": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "max_active_obligations": { "type": "integer" },
        "max_tracked_correlations": { "type": "integer" }
      }
    },
    "ResponseDecl": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "rules"],
      "properties": {
        "name": { "$ref": "#/$defs/RuntimeIdent" },
        "rules": {
          "type": "array",
          "items": { "$ref": "#/$defs/RuleDecl" }
        }
      }
    },
    "RuleDecl": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "trigger", "do"],
      "properties": {
        "id": { "$ref": "#/$defs/RuntimeIdent" },
        "trigger": { "$ref": "#/$defs/TriggerDecl" },
        "do": { "type": "string" },
        "approval": { "type": "string" },
        "target": { "type": "string" },
        "severity": { "type": "string" },
        "fallback": { "type": "string" },
        "rate_floor": { "type": "number" },
        "repeat_after_hours": { "type": "integer" },
        "max_repeats": { "type": "integer" },
        "on_check_error": { "type": "string" },
        "deploy": { "type": "string" },
        "only_while": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/GuardDecl"
          }
        },
        "unless": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/GuardDecl"
          }
        },
        "persist": { "$ref": "#/$defs/PersistDecl" }
      }
    },
    "TriggerDecl": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "monitor",
            "event"
          ],
          "properties": {
            "monitor": {
              "$ref": "#/$defs/RuntimeIdent"
            },
            "event": {
              "type": "string",
              "x-enum": [
                "unknown_for"
              ]
            },
            "hours": {
              "type": "integer"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "rule",
            "event"
          ],
          "properties": {
            "rule": {
              "$ref": "#/$defs/RuntimeIdent"
            },
            "event": {
              "type": "string",
              "x-enum": [
                "optimize_no_candidate",
                "optimize_failed",
                "deploy_refused",
                "deploy_failed"
              ],
              "examples": [
                "optimize_no_candidate",
                "optimize_failed",
                "deploy_refused",
                "deploy_failed"
              ]
            }
          }
        }
      ]
    },
    "RuntimeAggregateDecl": {
      "type": "object",
      "additionalProperties": false,
      "description": "TVL 1.5 (RFC 0005 §2.3): census aggregate. The schema checks closed keys and primitive types; the operator and metric registries and the source commitment are checked by lints.",
      "properties": {
        "op": { "type": "string", "examples": ["mean", "sum"], "x-enum": ["mean", "sum"] },
        "metric": { "type": "string", "examples": ["cost_usd", "score"], "x-enum": ["cost_usd", "score"] },
        "source_digest": { "type": "string" }
      }
    },
    "BoundDecl": {
      "type": "object",
      "additionalProperties": false,
      "description": "TVL 1.5 (RFC 0005 §2.3): one comparator. Exactly one key is a variant rule checked by lints.",
      "properties": {
        "lte": { "type": "number" },
        "gte": { "type": "number" }
      }
    },
    "PersistDecl": {
      "type": "object",
      "additionalProperties": false,
      "description": "TVL 1.5 (RFC 0005 §2.2): breach persistence on a notification. Integer ranges are checked by lints.",
      "properties": {
        "breached_in": { "type": "integer" },
        "of_last": { "type": "integer" }
      }
    },
    "GuardDecl": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "monitor",
            "state"
          ],
          "properties": {
            "monitor": {
              "$ref": "#/$defs/RuntimeIdent"
            },
            "state": {
              "type": "string",
              "examples": [
                "episode_open"
              ],
              "x-enum": [
                "episode_open"
              ]
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "rule",
            "state"
          ],
          "properties": {
            "rule": {
              "$ref": "#/$defs/RuntimeIdent"
            },
            "state": {
              "type": "string",
              "examples": [
                "attempt_open"
              ],
              "x-enum": [
                "attempt_open"
              ]
            }
          }
        }
      ]
    }
  }
}
